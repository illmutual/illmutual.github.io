
---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";

const {
  title = "ill mutual",
  description = "a personal archive of writing, research, and other things"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>


<body class="site-body">
  <Header />
  <slot />
</body>

</html>

<style is:global>
  body.site-body {
    background: #9bb588;
    margin: 0;
  }
</style>