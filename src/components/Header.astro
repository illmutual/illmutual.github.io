---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="topbar">
  <div class="brand">

   <div class="header-banner">
  <img
    src="/header-art.jpeg"
    alt="Black-and-white cat collage"
    class="banner-center"
  />
</div>

    <h1>ill mutual</h1>
    <p>a personal archive of sorts</p>

  </div>

<nav class="nav" aria-label="Main navigation">
  <a href="/writing">writing</a>
  <a href="/projects">projects</a>
  <a href="/research">research</a>
  <a href="/about">about</a>
</nav>

</header>


<style>
  .topbar {
	max-width: 1400px;
	margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 0;
    background: #9bb588;
    border-bottom: 2px solid #263d2d;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding: 0;
    text-align: center;
  }

  .header-banner {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background-image: url("/header-art.jpeg");
    background-repeat: repeat-x;
    background-size: auto 220px;
    background-position: center top;
  }

  .banner-center {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    height: 220px;
    width: auto;
    display: block;
  }

  .brand h1 {
    margin: 0;
    padding-top: 1.25rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.5rem, 7vw, 6rem);
    font-weight: normal;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: #263d2d;
  }

  .brand p {
    margin: 0;
    padding: 0.3rem 0 1.75rem;
    font-family: Georgia, serif;
    font-size: 1rem;
    font-style: italic;
    color: #405b3c;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    padding: 1rem;
    background: #dce5d1;
    border-top: 1px solid #526b45;
    border-bottom: 1px solid #526b45;
  }

  .nav a {
    color: #263d2d;
    font-family: Georgia, serif;
    font-size: 1.1rem;
    font-weight: bold;
    text-decoration: none;
    padding: 0.3rem 0.8rem;
    background: transparent;
    border: none;
  }

  .nav a:hover {
    color: #526b45;
    text-decoration: underline;
  }


.nav a + a::before {
  content: "";
  display: inline-block;
  width: 12px;
  height: 12px;
  margin-right: 1.6rem;
  background: #526b45;

  clip-path: polygon(
    45% 0%, 55% 0%,
    55% 35%, 75% 15%,
    85% 25%, 65% 45%,
    100% 45%, 100% 55%,
    65% 55%, 85% 75%,
    75% 85%, 55% 65%,
    55% 100%, 45% 100%,
    45% 65%, 25% 85%,
    15% 75%, 35% 55%,
    0% 55%, 0% 45%,
    35% 45%, 15% 25%,
    25% 15%, 45% 35%
  );

  vertical-align: middle;
  pointer-events: none;
}


  @media (max-width: 600px) {
    .header-banner {
      height: 130px;
      background-size: auto 130px;
    }

    .banner-center {
      height: 150px;
    }

    .brand h1 {
      font-size: 3.5rem;
      padding-top: 1rem;
    }

    .brand p {
      font-size: 0.85rem;
      padding-bottom: 1rem;
    }

    .nav {
      padding: 0.65rem;
      gap: 0.2rem;
    }

    .nav a {
      font-size: 0.9rem;
      padding: 0.3rem;
    }

    .nav a + a::before {
  margin-right: 0.5rem;
}
  }
</style>
