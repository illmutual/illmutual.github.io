
---
import Layout from "../layouts/Page.astro";
import PageContent from "../components/PageContent.astro";
---

<Layout>
<PageContent>
  <main class="writing-page">
    <a href="/" class="back-link">← back home</a>

    <p class="intro">
  an index of things written, finished, and otherwise.
</p>

    
<section>
  <h2>fiction</h2>

  <a href="/writing/mother-of-pearl" class="writing-entry">
    <div class="entry-heading">
      <h3>Mother of Pearl</h3>
      <span class="entry-year">2026</span>
    </div>

    <p>
      an unfinished horror on having a uterus
    </p>

    <span class="read-more">read me ↗</span>
  </a>

  <a href="/writing/untitled-01" class="writing-entry">
    <div class="entry-heading">
      <h3>Untitled</h3>
      <span class="entry-year">2026</span>
    </div>

    <p>
      an unfinished short story about never knowing how you ended up here
    </p>

    <span class="read-more">read me ↗</span>
  </a>

   <a href="/writing/bodies" class="writing-entry">
    <div class="entry-heading">
      <h3>Bodies</h3>
      <span class="entry-year">2026</span>
    </div>

    <p>
      an unfinished horror on disability
    </p>

    <span class="read-more">read me ↗</span>
  </a>
</section>


   
<section>
  <h2>poetry</h2>

  <a href="/writing/obituary-for-plans" class="writing-entry">
    <div class="entry-heading">
      <h3>Obituary for Plans</h3>
      <span class="entry-year">2026</span>
    </div>
    <span class="read-more">read me ↗</span>
  </a>
</section>


<section>
  <h2>essays & other</h2>

  
<a href="/writing/the-country" class="writing-entry">
  <div class="entry-heading">
    <h3>The Country</h3>
    <span class="entry-year">2026</span>
  </div>

  <p>
    on the history and disappearance of a queer nightclub in san antonio
  </p>

  <span class="read-more">read me ↗</span>
</a>

</section>
  </main>
  </PageContent>
</Layout>

<style>


.writing-entry {
  display: block;
  padding: 1.25rem 1rem;
  border-bottom: 1px solid #a4b49b;
  color: inherit;
  text-decoration: none;
  transition: background 0.2s ease;
}

.writing-entry:hover {
  background: #dce5d1;
}

.read-more {
  font-size: 0.9rem;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.entry-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
}

.entry-heading h3 {
  font-family: Georgia, serif;
  font-size: 1.6rem;
  font-weight: normal;
  margin: 0;
}

.entry-year {
  font-family: monospace;
  font-size: 0.8rem;
  color: #526b45;
}

.writing-entry p {
  margin: 0.6rem 0;
  line-height: 1.6;
}

.writing-entry:focus-visible {
  outline: 2px solid #263d2d;
  outline-offset: 3px;
}

.writing-entry:hover .read-more {
  color: #526b45;
}

  h1 {
    font-size: 3.5rem;
    margin: 1rem 0;
  }

  
.writing-page {
  counter-reset: writing-section;
}

h2 {
  counter-increment: writing-section;
  display: flex;
  align-items: baseline;
  gap: 1rem;
  border-bottom: 1px solid #526b45;
  padding-bottom: 0.5rem;
  font-size: 2rem;
  font-weight: normal;
}

h2::before {
  content: counter(writing-section, decimal-leading-zero) " /";
  font-family: monospace;
  font-size: 0.8rem;
  color: #526b45;
}


  section {
    margin-top: 2rem;
  }

  .back-link {
    color: #263d2d;
  }

  .intro {
    font-style: italic;
  }
</style>
