
---
import Layout from "../layouts/Page.astro";
---

<Layout>
  <main class="writing-page">
    <a href="/" class="back-link">← back home</a>

    <p class="intro">
  an index of things written, finished, and otherwise.
</p>

    <section>
      <h2>fiction</h2>
      <p>coming soon.</p>
    </section>

    <section>
      <h2>poetry</h2>
      <p>coming soon.</p>
    </section>

<section>
  <h2>essays & other</h2>

  
<div class="writing-entry">
  <div class="entry-heading">
    <h3>The Country</h3>
    <span class="entry-year">2026</span>
  </div>

  <p>
    on the history and disappearance of a queer nightclub in san antonio
  </p>

  <a href="/writing/the-country">
    read me ↗
  </a>
</div>

</section>
  </main>
</Layout>

<style>



.writing-entry {
  padding: 1.25rem 0;
  border-bottom: 1px solid #a4b49b;
}

.entry-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
}

.entry-heading h3 {
  font-family: Georgia, serif;
  font-size: 1.6rem;
  font-weight: normal;
  margin: 0;
}

.entry-year {
  font-family: monospace;
  font-size: 0.8rem;
  color: #526b45;
}

.writing-entry p {
  margin: 0.6rem 0;
  line-height: 1.6;
}

.writing-entry a {
  color: #263d2d;
  font-size: 0.9rem;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.writing-entry a:hover {
  color: #526b45;
}


  .writing-page {
    max-width: 760px;
    margin: 3rem auto;
    padding: 2rem;
    background: #e7ebdc;
    border: 1px solid #526b45;
    color: #263d2d;
  }

  h1 {
    font-size: 3.5rem;
    margin: 1rem 0;
  }

  h2 {
    border-bottom: 1px solid #526b45;
    padding-bottom: 0.5rem;
  }

  section {
    margin-top: 2rem;
  }

  .back-link {
    color: #263d2d;
  }

  .intro {
    font-style: italic;
  }
</style>
