
---
import Layout from "../layouts/Page.astro";
---

<Layout>
  <main class="page">
    <a href="/">← back home</a>

    <h1>research</h1>

    <p class="intro">
      they call me the woker
    </p>

    <section>
      <h2>research projects</h2>
      <p>work in progress.</p>
    </section>

    <section>
      <h2>papers & publications</h2>
      <p>coming soon.</p>
    </section>
  </main>
</Layout>

<style>
  .page {
    width: calc(100% - 2rem);
    max-width: 760px;
    box-sizing: border-box;
    margin: 3rem auto;
    padding: 2rem;
    background: #e7ebdc;
    border: 1px solid #526b45;
    color: #263d2d;
  }

  h1 {
    font-family: Georgia, serif;
    font-size: 3rem;
  }

  h2 {
    border-bottom: 1px solid #526b45;
    padding-bottom: 0.5rem;
  }

  section {
    margin-top: 2rem;
  }

  .intro {
    font-style: italic;
  }

  a {
    color: #526b45;
  }
</style>
