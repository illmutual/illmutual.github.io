
---
import Layout from "../../layouts/Page.astro";
---

<Layout title="The Erasure Machine | ill mutual">
  <main class="machine">
    <a href="/projects" class="back-link">← back to projects</a>

    <h1>the erasure machine</h1>
    <p>the machine awaits.</p>

    <textarea
      id="source-text"
      placeholder="type something..."
    ></textarea>

    
<div class="controls">
  <button id="erase-button">erase</button>
  <button id="reset-button">start over ↺</button>
  <button id="poem-button">show poem ↗</button>
</div>

<div id="result"></div>
<div id="poem-result" hidden></div>
<button id="copy-button" hidden>copy poem ↗</button>

  </main>
</Layout>

<style>

#poem-button {
  background: transparent;
  color: #526b45;
  border: 1px solid #526b45;
}

#poem-button:hover {
  background: #dce5d1;
}

#poem-result:not([hidden]) {
  margin-top: 2rem;
  padding: 2rem;
  background: #f2f0e7;
  border: 1px solid #526b45;
  color: #263d2d;
  font-family: Georgia, serif;
  font-size: 1.25rem;
  line-height: 1.9;
}

.controls {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 1rem;
}

.controls button {
  margin-top: 0;
}

#reset-button {
  background: transparent;
  color: #526b45;
  border: 1px solid #526b45;
}

#reset-button:hover {
  background: #dce5d1;
}

  .machine {
    max-width: 800px;
    margin: 2rem auto;
    padding: 2rem;
    background: #e7ebdc;
    border: 1px solid #526b45;
    color: #263d2d;
  }

  textarea {
    width: 100%;
    min-height: 180px;
    box-sizing: border-box;
    padding: 1rem;
    background: #f2f0e7;
    border: 1px solid #526b45;
    font: inherit;
    resize: vertical;
  }

  button {
    display: block;
    margin-top: 1rem;
    padding: 0.65rem 1.5rem;
    background: #526b45;
    color: #fff;
    border: 0;
    cursor: pointer;
    font: inherit;
  }

 
#result {
  margin-top: 2rem;
  white-space: pre-wrap;
  font-family: Georgia, serif;
  font-size: 1.15rem;
  line-height: 2;
}


#result :global(.erased) {
  background: #171b17;
  color: transparent;
  user-select: none;
}




#result :global(.surviving) {
  color: #263d2d;
}



.machine .back-link,
.machine .back-link:visited {
  color: #526b45;
  font-size: 0.9rem;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.machine h1 {
  font-family: Georgia, serif;
  font-size: clamp(2rem, 5vw, 3rem);
  font-weight: normal;
  line-height: 1.15;
  margin: 1.25rem 0;
}

#copy-button {
  display: block;
  margin-top: 1rem;
  background: transparent;
  color: #526b45;
  border: 1px solid #526b45;
  padding: 0.65rem 1.5rem;
  cursor: pointer;
  font: inherit;
}
#copy-button[hidden] {
  display: none;
}
#copy-button:hover {
  background: #dce5d1;
}

</style>



<script>
  const input = document.querySelector("#source-text");
  const button = document.querySelector("#erase-button");
  const resetButton = document.querySelector("#reset-button");
  const result = document.querySelector("#result");
  const poemButton = document.querySelector("#poem-button");
  const poemResult = document.querySelector("#poem-result");
  const copyButton = document.querySelector("#copy-button");

  let originalText = "";
  let words = [];
  let survivors = [];
  let poemWords = [];

  // Words that are less interesting on their own
  const commonWords = new Set([
    "a", "an", "the", "and", "or", "but",
    "of", "to", "for", "with", "at", "by",
    "i", "you", "he", "she", "we", "they",
    "is", "was", "were", "are", "be",
    "it", "this", "that", "my", "your",
    "had", "has", "have", "in", "on"
  ]);

  // Remove punctuation when evaluating a word
  function clean(word) {
    return word.toLowerCase().replace(/[^a-z']/g, "");
  }

  

function scoreFragment(fragment) {
  let score = Math.random() * 2;

  const meaningfulWords = fragment.filter((word) => {
    const cleaned = clean(word);

    return cleaned.length >= 4 &&
      !commonWords.has(cleaned);
  });

  // Reward meaningful words
  score += meaningfulWords.length * 2;

  // Penalize longer fragments
  score -= fragment.length * 1.2;

  // Discourage fragments ending with connecting words
  const lastWord = clean(fragment[fragment.length - 1]);

  if (commonWords.has(lastWord)) {
    score -= 3;
  }

  return score;
}


  // Choose the words that will form the final poem
  function composePoem(words) {
    const selected = words.map(() => false);

    // Examine the source in groups of 15 words
    for (let start = 0; start < words.length; start += 20) {
      const end = Math.min(start + 20, words.length);

      // Sometimes leave an entire section behind
      if (Math.random() < 0.2) continue;

      let bestScore = -Infinity;
      let bestStart = start;
      let bestLength = 1;

      // Try different fragments within this section
      for (let i = start; i < end; i++) {
        for (let length = 1; length <= 4; length++) {
          if (i + length > end) break;

          const fragment = words.slice(i, i + length);
          const score = scoreFragment(fragment);

          if (score > bestScore) {
            bestScore = score;
            bestStart = i;
            bestLength = length;
          }
        }
      }

      // Preserve the strongest fragment
      for (let i = bestStart; i < bestStart + bestLength; i++) {
        selected[i] = true;
      }
    }

    return selected;
  }

  button?.addEventListener("click", () => {
    if (!(input instanceof HTMLTextAreaElement) ||
        !(result instanceof HTMLElement)) return;

    const text = input.value.trim();

    if (!text) {
      result.textContent = "nothing to erase.";
      return;
    }

    // Choose a new destination when the text changes
    if (text !== originalText) {
      originalText = text;
      words = text.split(/\s+/);

      survivors = words.map(() => true);
      poemWords = composePoem(words);
    }

    // Find words that are visible but not part of the poem
    
const removable = [];

words.forEach((word, index) => {
  if (survivors[index] && !poemWords[index]) {
    removable.push(index);
  }
});

    // Erase approximately 35% of what remains removable
    const amount = Math.ceil(removable.length * 0.35);

    // Shuffle the removable word positions
    removable.sort(() => Math.random() - 0.5);

    for (let i = 0; i < amount; i++) {
      survivors[removable[i]] = false;
    }

    // Display the result using our existing redactions
    result.replaceChildren();

    words.forEach((word, index) => {
      const span = document.createElement("span");

      span.textContent = word;
      span.className = survivors[index]
        ? "surviving"
        : "erased";

      
      result.appendChild(span);
      result.appendChild(document.createTextNode(" "));
    });

    // Update the poem view if it's currently visible
    if (poemResult instanceof HTMLElement && !poemResult.hidden) {
      poemResult.textContent = words
        .filter((word, index) => survivors[index])
        .join(" ");
    }
  });


resetButton?.addEventListener("click", () => {
  if (!(result instanceof HTMLElement)) return;
  if (poemResult instanceof HTMLElement) {
  poemResult.hidden = true;
  poemResult.textContent = "";
}

if (poemButton instanceof HTMLButtonElement) {
  poemButton.textContent = "show poem ↗";
}

if (copyButton instanceof HTMLButtonElement) {
  copyButton.hidden = true;
  copyButton.textContent = "copy poem ↗";
}

  // Forget the previous poem
  originalText = "";
  words = [];
  survivors = [];
  poemWords = [];

  // Clear the redacted document
  result.replaceChildren();
});

poemButton?.addEventListener("click", () => {
  if (!(poemResult instanceof HTMLElement)) return;
  if (!(poemButton instanceof HTMLButtonElement)) return;
  if (!(copyButton instanceof HTMLButtonElement)) return;

  if (poemResult.hidden) {
    const poem = words.filter((word, index) => survivors[index]);

    poemResult.textContent = poem.join(" ");
    poemResult.hidden = false;
    copyButton.hidden = false;
    poemButton.textContent = "hide poem ↗";
  } else {
    poemResult.hidden = true;
    copyButton.hidden = true;
    poemButton.textContent = "show poem ↗";
  }
});

copyButton?.addEventListener("click", async () => {
  if (!(copyButton instanceof HTMLButtonElement)) return;

  const poem = words
    .filter((word, index) => survivors[index])
    .join(" ");

  if (!poem) {
    copyButton.textContent = "nothing to copy";
    return;
  }

  try {
    await navigator.clipboard.writeText(poem);

    copyButton.textContent = "copied! ✓";
  } catch (error) {
    copyButton.textContent = "copy failed";
    console.error("Could not copy poem:", error);
  }
});

</script>

