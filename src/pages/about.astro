
---
import Layout from "../layouts/Page.astro";
import PageContent from "../components/PageContent.astro";
---

<Layout>
<PageContent>
  <main class="about-page">
    <a href="/" class="back-link">← back home</a>

    <h1>about</h1>

    <section>
      <h2>who's asking?</h2>

      <p>
        bk / twenty-something / san antonio, tx
      </p>

      <p>
        i study poverty in the rural south, particularly
        its relationship to racial capitalism, labor,
        and urban development.
      </p>

      <p>
        otherwise, i'm probably coding or bothering my cats.
      </p>
    </section>

    <section>
      <h2>about this site</h2>

      <p>
        ill mutual is my personal archive for writing,
        research, projects, and things i want to keep.
      </p>
    </section>
  </main>
  </PageContent>
</Layout>

<style>

  h1 {
    font-family: Georgia, serif;
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: normal;
  }

  h2 {
    font-family: Georgia, serif;
    border-bottom: 1px solid #526b45;
    padding-bottom: 0.5rem;
  }

  section {
    margin-top: 2rem;
  }

  p {
    line-height: 1.7;
  }

  .back-link {
    color: #526b45;
  }
</style>
